NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://pos:pos@localhost:5433/pos_inventory?schema=public"
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Used only by `pnpm --filter api seed` to create the first platform admin account
PLATFORM_ADMIN_EMAIL=platform-admin@pos.local
PLATFORM_ADMIN_PASSWORD=change-me-please
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
