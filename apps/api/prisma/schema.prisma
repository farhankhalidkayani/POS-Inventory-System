generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  status         OrganizationStatus @default(PENDING)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  suspendedAt    DateTime?
  stores         Store[]
  users          User[]
  categories     Category[]
  products       Product[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  sales          Sale[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  customers      Customer[]
  discounts      Discount[]
  invites        Invite[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

model Store {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role
  isPlatformAdmin Boolean     @default(false)
  sales          Sale[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

enum StockMovementType {
  RECEIVE
  SALE
  ADJUSTMENT
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  sku            String
  name           String
  description    String?
  barcode        String?
  priceCents     Int
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  saleLineItems  SaleLineItem[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
}

model InventoryItem {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  quantity          Int      @default(0)
  reorderThreshold  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([organizationId])
  @@index([storeId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantityChange Int
  note           String?
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([storeId, productId])
}

enum PaymentMethod {
  CASH
  CARD
}

model Sale {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id])
  discountId       String?
  discount         Discount?      @relation(fields: [discountId], references: [id])
  paymentMethod    PaymentMethod
  paymentReference String?
  subtotalCents    Int            @default(0)
  discountCents    Int            @default(0)
  totalCents       Int
  lineItems        SaleLineItem[]
  createdAt        DateTime       @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([customerId])
}

model SaleLineItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([saleId])
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  contactEmail   String?
  contactPhone   String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

model PurchaseOrder {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  storeId        String
  store          Store                   @relation(fields: [storeId], references: [id])
  supplierId     String
  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus     @default(ORDERED)
  totalCostCents Int
  lineItems      PurchaseOrderLineItem[]
  receivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId])
  @@index([storeId])
}

model PurchaseOrderLineItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCostCents    Int

  @@index([purchaseOrderId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  firstName      String
  lastName       String
  email          String?
  phone          String?
  sales          Sale[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  type           DiscountType
  value          Int
  active         Boolean      @default(true)
  sales          Sale[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  role           Role
  token          String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
